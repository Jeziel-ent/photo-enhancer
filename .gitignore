*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/
env/

# AI model weights
*.pth
*.pt
*.onnx
*.safetensors
models/

# Session research results are kept locally, not committed -- except the
# two small benchmark JSONs cited by docs/PERFORMANCE_OPTIMIZATION.md.
image_enhancer/research_results/*
!image_enhancer/research_results/gpu_swinir_optimized/
!image_enhancer/research_results/cpu_imdn_optimized/
image_enhancer/research_results/gpu_swinir_optimized/*
!image_enhancer/research_results/gpu_swinir_optimized/benchmark_gpu.json
image_enhancer/research_results/cpu_imdn_optimized/*
!image_enhancer/research_results/cpu_imdn_optimized/benchmark_cpu.json

# Generated enhancement outputs
image_enhancer/enhanced/
image_enhancer/reports/

# MVP 2 research workspace: downloaded datasets, downloaded model
# checkpoints, and generated benchmark/comparison outputs. Never committed --
# see docs/MVP2_RESEARCH.md for what's here and how to regenerate it.
research/datasets/
research/models/
research/inputs/
research/outputs/
research/benchmarks/
!research/benchmarks/*.csv
!research/benchmarks/*.json
research/reports/*.png
research/reports/*.jpg

# Backend generated output
# .workspace/ holds per-job input/output files and result zips for the API
backend/.workspace/

# Node / frontend
node_modules/
frontend/dist/
frontend/node_modules/
frontend/*.log

# Packaging build artifacts (PyInstaller dist/build + the compiled installer)
/dist/
/build/
packaging/output/
packaging/*.log

# Staged Microsoft Visual C++ Runtime prerequisite binary (official
# vc_redist.x64.exe, signed by Microsoft) -- a build-time staging artifact,
# not project source. Obtain/re-verify it per packaging/README.md.
packaging/vc_redist/

# Temporary files
*.tmp
*.temp
.DS_Store

# IDE
.vscode/
.idea/

# Python tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
# Local packaging/build backups
dist_moved_dlls_backup/
dist_w2.0_backup/

